# Shopify. The CLI injects these into its own dev process; `npm run env -- pull`
# supplies them to standalone workers, scripts, and Compose.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://localhost:3000
SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations,read_orders,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders,read_discounts,read_locales,write_locales,read_translations,write_translations,read_markets,read_content,read_online_store_pages,read_online_store_navigation

# AI translation (docs/translations.md § OpenAI). One server-side key for the
# deployment; never shown in the UI, never stored, never logged. Leave blank
# to run without AI translation. The model is optional and defaults to
# gpt-4.1-mini; its pricing must be in src/domain/translations/pricing.ts for
# costs to be estimated.
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=

# Optional custom shop domain accepted by Shopify authentication.
SHOP_CUSTOM_DOMAIN=

# Host-side PostgreSQL connection used by npm scripts and local development.
DATABASE_URL=postgresql://recharge_hub:recharge_hub@localhost:5432/recharge_hub?schema=public

# Compose database values. Replace the password before production; Compose
# derives its container-side DATABASE_URL from these three values.
POSTGRES_USER=recharge_hub
POSTGRES_PASSWORD=recharge_hub
POSTGRES_DB=recharge_hub

# AES-256-GCM master key for secrets at rest (docs/BUILD_SPEC.md section 10).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Production ingress. Host port the web container is published on for the
# host's nginx (ops/nginx/recharge-hub.conf) to proxy to.
WEB_PORT=3192

# Only with `docker compose --profile caddy`: hostname Caddy obtains a
# certificate for. `localhost` makes Caddy use a local certificate.
APP_DOMAIN=localhost

# Image Compose runs on the server. Built and pushed with scripts/build-and-push.bat.
# Leave blank for time4action/recharge-hub:latest; set e.g. :dev to run that tag.
APP_IMAGE=

# Error reporting. Leave SENTRY_DSN blank to disable it.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

LOG_LEVEL=info
PORT=3000
