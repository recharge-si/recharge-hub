# Shopify. The CLI injects these into its own dev process; `npm run env -- pull`
# supplies them to standalone workers, scripts, and Compose.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://localhost:3000
SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations,read_orders,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders,read_discounts,read_locales,write_locales,read_translations,write_translations,read_markets,read_content,read_online_store_pages,read_online_store_navigation,write_online_store_navigation,read_publications,write_publications

# AI translation (docs/translations.md § OpenAI). One server-side key for the
# deployment; never shown in the UI, never stored, never logged. Leave blank
# to run without AI translation. The model is optional and defaults to
# gpt-4.1-mini; its pricing must be in src/domain/translations/pricing.ts for
# costs to be estimated.
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=

# Export portal (docs/sources.md). The origin of the portal's API server (the
# one serving /api/v1 — t4a-partner-portal-api, not the portal's web UI), one
# per deployment; the API key is per store and is pasted into Sources >
# Connection inside the app. Leave blank to run without the Sources area.
EXPORT_PORTAL_URL=

# Optional custom shop domain accepted by Shopify authentication.
SHOP_CUSTOM_DOMAIN=

# Host-side PostgreSQL connection used by npm scripts and local development.
DATABASE_URL=postgresql://recharge_hub:recharge_hub@localhost:5432/recharge_hub?schema=public

# Compose database values. Replace the password before production; Compose
# derives its container-side DATABASE_URL from these three values.
POSTGRES_USER=recharge_hub
POSTGRES_PASSWORD=recharge_hub
POSTGRES_DB=recharge_hub

# AES-256-GCM master key for secrets at rest (docs/BUILD_SPEC.md section 10).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Production ingress. Host port the web container is published on for the
# host's nginx (ops/nginx/recharge-hub.conf) to proxy to.
WEB_PORT=3192

# Only with `docker compose --profile caddy`: hostname Caddy obtains a
# certificate for. `localhost` makes Caddy use a local certificate.
APP_DOMAIN=localhost

# Image Compose runs on the server. Built and pushed to GHCR by CI.
# Leave blank for ghcr.io/recharge-si/recharge-hub:latest.
APP_IMAGE=

# Error reporting. Leave SENTRY_DSN blank to disable it.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

LOG_LEVEL=info
PORT=3000

# The AI rig builder (docs/rig-builder.md). Explanations go through claude-pool;
# leave all of these blank for the defaults. Without the pool the builder still
# works, in plain mode.
# Model alias passed to `claude --model` (default sonnet).
RIG_AI_MODEL=
# Concurrent model calls in the web process; the next one is answered in plain mode (default 3).
RIG_AI_MAX_CONCURRENT=
# Model calls per shop per UTC day, then plain mode (default 500).
RIG_AI_DAILY_CALLS=
# Time one explain may spend on the model, in milliseconds (default 20000).
RIG_AI_TIMEOUT_MS=
# Builds per caller per minute and per hour (defaults 60 and 600). Explain is fixed at 3 and 10.
RIG_BUILD_PER_MINUTE=
RIG_BUILD_PER_HOUR=
# Host directory with the claude-pool accounts, mounted read-only into the web
# container at /run/claude-pool (default ./data/claude-pool).
CLAUDE_POOL_DIR_HOST=
