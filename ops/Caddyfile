# TLS is Caddy's job: it obtains and renews Let's Encrypt certificates
# automatically for APP_DOMAIN (docs/BUILD_SPEC.md section 4).
#
# Set APP_DOMAIN in .env to the public hostname. Leaving it as `localhost` makes
# Caddy serve its own local certificate, which is what you want on a dev machine.

{$APP_DOMAIN} {
	encode zstd gzip

	# Shopify webhooks and the admin iframe both come through here.
	reverse_proxy web:3000 {
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output stdout
		format json
	}
}
