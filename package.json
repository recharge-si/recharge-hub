{
  "name": "fulfilment-orchestrator",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "shopify app dev",
    "dev:worker": "tsx watch src/jobs/worker.ts",
    "dev:web": "react-router dev",
    "build": "react-router build && npm run build:worker",
    "build:worker": "esbuild src/jobs/worker.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=build/worker/worker.js",
    "start": "react-router-serve ./build/server/index.js",
    "start:worker": "node build/worker/worker.js",
    "setup": "prisma generate && prisma migrate deploy",
    "docker-start": "npm run setup && npm run start",
    "lint": "eslint .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "config:link": "shopify app config link",
    "env": "shopify app env",
    "deploy": "shopify app deploy",
    "shopify": "shopify",
    "prisma": "prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@sentry/node": "^10.71.0",
    "@shopify/shopify-app-react-router": "^1.1.0",
    "@shopify/shopify-app-session-storage": "^5.0.1",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "isbot": "^5.1.31",
    "pg-boss": "^12.28.0",
    "pino": "^10.3.1",
    "prisma": "^6.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@react-router/dev": "^7.12.0",
    "@react-router/fs-routes": "^7.12.0",
    "@shopify/app-bridge-types": "^0.7.2",
    "@shopify/polaris-types": "^1.0.7",
    "@types/node": "^25.5.2",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "p-map": "^4.0.0"
  }
}
