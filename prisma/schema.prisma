// Fulfilment Orchestrator's current physical data model. See
// docs/architecture.md for the persistence map and docs/BUILD_SPEC.md section 6
// for the conceptual target. Migration history is additive and immutable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Shopify offline session. The shape is dictated by PrismaSessionStorage, so the
/// field names cannot be changed. `accessToken` and `refreshToken` are written
/// encrypted by adapters/db/encrypted-session-storage.server.ts
/// (docs/BUILD_SPEC.md section 2.2).
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
  @@map("session")
}

enum ShopInstallState {
  installed
  uninstalled

  @@map("shop_install_state")
}

model Shop {
  id            String           @id @default(cuid())
  domain        String           @unique
  installState  ShopInstallState @default(installed) @map("install_state")
  installedAt   DateTime         @default(now()) @map("installed_at")
  uninstalledAt DateTime?        @map("uninstalled_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  /// When the pricelist register was last read, whatever that read found.
  ///
  /// Deliberately apart from `metakocka_pricelist.observed_at`, which records
  /// when a code was last *seen*. A read that finds nothing — every pricelist
  /// deleted in MetaKocka, or every price taken off — updates no row at all,
  /// so without a timestamp of its own the screen reports the last sighting as
  /// the last read, and goes on offering pricelists that no longer exist.
  /// MetaKocka cannot list pricelists (docs/BUILD_SPEC.md §3), so the absence of a code
  /// from a read is the only signal there is.
  pricelistsReadAt DateTime? @map("pricelists_read_at")

  /// How far the order reconciler has read (docs/BUILD_SPEC.md section 8.10).
  ///
  /// Shopify webhooks are best-effort: they are retried for a while and then
  /// dropped, and an app that is down for an afternoon simply never hears about
  /// what happened in it. So a scheduled pass re-reads every order Shopify has
  /// touched since this mark and applies whatever it finds. Null means the
  /// reconciler has never run, and the first run deliberately starts from a
  /// short window rather than the beginning of time.
  ordersReconciledThrough DateTime? @map("orders_reconciled_through")

  /// How far the MetaKocka document poll has read. See `poll-metakocka-documents`.
  documentsPolledThrough DateTime? @map("documents_polled_through")

  /// When the merchant pressed Finish setup, and nothing else.
  ///
  /// This is the **activation boundary**: guided setup collects credentials and
  /// mappings step by step, and a shop half way through one is a shop whose
  /// answers are half chosen. Writing an ERP document off a half-configured
  /// store is not something an undo exists for, so the two MetaKocka writers
  /// (`write-metakocka-order` and `sync-inventory`) refuse until this is set.
  ///
  /// It is deliberately **not** a second source of truth for whether the
  /// integration is configured — `domain/readiness` answers that from the
  /// configuration itself, and Finish setup refuses while readiness disagrees.
  /// This only records that a person said "start".
  ///
  /// Back-filled for every shop that already had MetaKocka credentials when
  /// this column was added, because those shops were already synchronizing and
  /// this must not stop them.
  setupCompletedAt DateTime? @map("setup_completed_at")

  /// The guided-setup step this shop last reached, so leaving the page does not
  /// mean starting again. Pure UI state: it decides nothing.
  setupStep String? @map("setup_step")

  eventLogs              EventLog[]
  metakockaCredential    MetakockaCredential?
  supplySources          SupplySource[]
  metakockaWarehouses    MetakockaWarehouse[]
  metakockaPaymentTypes  MetakockaPaymentType[]
  metakockaProfitCenters MetakockaProfitCenter[]
  metakockaPricelists    MetakockaPricelist[]
  metakockaTaxRates      MetakockaTaxRate[]
  skus                   Sku[]
  paymentTypeMaps        PaymentTypeMap[]
  paymentSetting         PaymentSetting?
  salesOrderSetting      SalesOrderSetting?
  supplySetting          SupplySetting?
  productSyncSetting     ProductSyncSetting?
  orders                 Order[]
  orderPayments          OrderPayment[]
  metakockaDocuments     MetakockaDocument[]
  exceptions             Exception[]

  @@map("shop")
}

/// Append-only audit trail. docs/BUILD_SPEC.md section 6: the audit trail is a product
/// feature, not debug output. Never updated, never deleted outside the section 2.4
/// retention job.
model EventLog {
  id         String   @id @default(cuid())
  shopId     String   @map("shop_id")
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  event      String
  detail     Json?
  at         DateTime @default(now())
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, at])
  @@index([shopId, entityType, entityId])
  @@map("event_log")
}

/// Exactly-once guard for work triggered by an at-least-once source
/// (docs/BUILD_SPEC.md section 6). Shopify redelivers webhooks and MetaKocka offers no
/// idempotency keys of its own, so duplicate prevention is entirely ours.
///
/// Deviation from section 6, deliberate: the tenant is held as a domain string
/// rather than a foreign key to `shop`. Compliance webhooks arrive for shops
/// whose row has already been deleted, and the guard has to keep working then.
model IdempotencyKey {
  id          String   @id @default(cuid())
  shopDomain  String   @map("shop_domain")
  scope       String
  key         String
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  result      Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([shopDomain, scope, key])
  @@index([firstSeenAt])
  @@map("idempotency_key")
}

/// MetaKocka connection for one shop (docs/BUILD_SPEC.md section 6).
///
/// The secret key grants full write access to the merchant's ERP and there is no
/// read-only mode and no rotation (section 3), so it is treated as a production
/// database password: encrypted at rest, never returned to the browser, never
/// logged (section 10).
model MetakockaCredential {
  id                           String    @id @default(cuid())
  shopId                       String    @unique @map("shop_id")
  companyId                    String    @map("company_id")
  secretKeyEncrypted           String    @map("secret_key_encrypted")
  /// Used to verify the HMAC-SHA1 signature on the stock webhook. Optional
  /// because a merchant can connect before registering the webhook.
  webhookClientSecretEncrypted String?   @map("webhook_client_secret_encrypted")
  /// Required by `sync_stock`, which is how stock is written back into
  /// MetaKocka. Not a secret, but it is part of the connection.
  apiUserEmail                 String?   @map("api_user_email")
  /// Last time a call to MetaKocka actually succeeded with these credentials.
  lastVerifiedAt               DateTime? @map("last_verified_at")
  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                    DateTime  @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("metakocka_credential")
}

/// Which system holds the correct stock for a warehouse, and therefore which
/// way stock is copied. docs/BUILD_SPEC.md §7 only modelled MetaKocka to Shopify; some
/// warehouses are counted in Shopify instead, and those write back to the ERP.
enum StockDirection {
  /// MetaKocka is the truth. Its `amount` becomes Shopify on hand.
  mk_to_shopify
  /// Shopify is the truth. Its on hand is written into the MetaKocka warehouse.
  shopify_to_mk
  /// Neither. Something or someone else keeps both sides right.
  none

  @@map("stock_direction")
}

enum SupplySourceKind {
  own
  partner

  @@map("supply_source_kind")
}

/// Who is allowed to write inventory into the Shopify location (docs/BUILD_SPEC.md §7).
/// Enforced as a throw in the inventory adapter, not as a convention.
enum InventoryWriter {
  /// This app writes it, from MetaKocka stock. Own warehouses only.
  metakocka
  /// Another app owns it. Never write these.
  external
  /// A human owns it. Never write.
  manual

  @@map("inventory_writer")
}

/// One place stock can come from: an own warehouse or a partner (docs/BUILD_SPEC.md §6).
model SupplySource {
  id     String @id @default(cuid())
  shopId String @map("shop_id")

  code String
  name String
  kind SupplySourceKind @default(own)

  shopifyLocationId       String?         @map("shopify_location_id")
  inventoryWriter         InventoryWriter @default(external) @map("inventory_writer")
  stockDirection          StockDirection  @default(none) @map("stock_direction")
  /// True when `stockDirection` above was copied from the shop default
  /// rather than chosen for this source (docs/BUILD_SPEC.md §7). The effective value
  /// stays materialised so the sync engine reads one column and no caller has
  /// to resolve a default; this records only where that value came from, and
  /// is what lets a change to the default flow through to the sources that
  /// never overrode it.
  stockDirectionInherited Boolean         @default(false) @map("stock_direction_inherited")

  /// The `mark` of a MetaKocka warehouse. MetaKocka accepts an unknown value
  /// silently (§3), so this is validated against warehouse_list on save.
  metakockaWarehouse     String? @map("metakocka_warehouse")
  /// Stable MetaKocka id of that warehouse. Documents are addressed by mark, so
  /// the mark is what gets sent, but the mark changes when a warehouse is
  /// renamed. Following the id lets a reload update the mark in place instead
  /// of retiring a source that never went anywhere.
  metakockaWarehouseMkId String? @map("metakocka_warehouse_mk_id")
  metakockaProfitCenter  String? @map("metakocka_profit_center")
  /// As `stockDirectionInherited`, for the profit centre.
  profitCenterInherited  Boolean @default(false) @map("profit_center_inherited")

  /// Lower runs first in allocation.
  /// How the last stock sync for this location went, and when.
  ///
  /// Stock sync had no per-location outcome at all: the job logged one line for
  /// the whole run and let one location's failure throw, which killed the sweep
  /// and re-ran every location in front of it on the next retry. A location
  /// that had failed every attempt for nine hours still showed as "Syncing",
  /// and a status nobody can tell apart from working is worse than none.
  lastSyncAt      DateTime? @map("last_sync_at")
  lastSyncOk      Boolean?  @map("last_sync_ok")
  /// What went wrong, in the merchant's words. Null when the last run worked.
  lastSyncMessage String?   @map("last_sync_message")
  /// Consecutive failures. One blip is not news; an hour of them is.
  syncFailures    Int       @default(0) @map("sync_failures")

  priority            Int     @default(100)
  leadTimeDays        Int     @default(0) @map("lead_time_days")
  defaultDeliveryType String? @map("default_delivery_type")
  canSplit            Boolean @default(true) @map("can_split")
  enabled             Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop         Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplyLevels SupplyLevel[]
  allocations  Allocation[]
  documents    MetakockaDocument[]

  @@unique([shopId, code])
  @@index([shopId, priority])
  @@map("supply_source")
}

/// Shopify payment gateway to MetaKocka payment type (docs/BUILD_SPEC.md §6, §8.7).
/// No MetaKocka endpoint lists the accepted strings, so this is merchant-entered
/// and an unmapped gateway raises an exception rather than being guessed.
model PaymentTypeMap {
  id                   String @id @default(cuid())
  shopId               String @map("shop_id")
  shopifyGateway       String @map("shopify_gateway")
  metakockaPaymentType String @map("metakocka_payment_type")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, shopifyGateway])
  @@map("payment_type_map")
}

/// Local copy of the MetaKocka warehouse list.
///
/// Two reasons this is cached rather than fetched when a screen renders:
/// docs/BUILD_SPEC.md §2.5 forbids any page load awaiting MetaKocka, and §3 (verified)
/// says MetaKocka silently accepts a warehouse mark that does not exist. Holding
/// the list locally lets the supply source form offer a choice instead of a free
/// text field, so an invalid mark cannot be saved in the first place.
///
/// Refreshed explicitly by the merchant and by the quarter-hourly scheduled
/// reconciliation fan-out.
model MetakockaWarehouse {
  id     String @id @default(cuid())
  shopId String @map("shop_id")

  mkId               String  @map("mk_id")
  mark               String
  name               String
  isMain             Boolean @default(false) @map("is_main")
  isActive           Boolean @default(true) @map("is_active")
  includeInStockInfo Boolean @default(false) @map("include_in_stock_info")

  syncedAt  DateTime @default(now()) @map("synced_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  /// Keyed on the MetaKocka id, not the mark. A merchant who renames a
  /// warehouse changes its mark, and keying the cache on the mark made a rename
  /// look like a deletion followed by an unrelated new warehouse.
  @@unique([shopId, mkId])
  @@index([shopId, mark])
  @@map("metakocka_warehouse")
}

/// Payment types this company accepts, discovered from MetaKocka.
///
/// docs/BUILD_SPEC.md §8.7 says no endpoint lists them. Verified: sending an invalid
/// `payment_type` returns the whole valid set in the error description, and the
/// request is rejected before a document is created. That list is cached here so
/// the settings screen can offer a choice instead of a free text field, without
/// a page load ever awaiting MetaKocka (§2.5).
model MetakockaPaymentType {
  id     String @id @default(cuid())
  shopId String @map("shop_id")

  value String

  syncedAt  DateTime @default(now()) @map("synced_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, value])
  @@map("metakocka_payment_type")
}

/// Profit centres this company accepts, as a merchant-maintained register.
///
/// Unlike the warehouse list there is no endpoint behind this. docs/BUILD_SPEC.md §3
/// says MetaKocka cannot list profit centres, and unlike payment types the
/// rejection does not enumerate the valid set either: it only ever says
/// `"Profit center 'X' doesn't exist."`. So the register is what the merchant
/// adds, and every entry is checked against the live company before it lands
/// here (adapters/metakocka/profit-centers.ts). That check writes nothing.
///
/// The point of holding it is that a profit centre must match MetaKocka
/// exactly and MetaKocka refuses a document outright when it does not (§3,
/// verified). A register turns every other screen's free text field into a
/// choice, so the typo is caught once, here, rather than on an order.
model MetakockaProfitCenter {
  id     String @id @default(cuid())
  shopId String @map("shop_id")

  value String

  /// False once MetaKocka has told us this name no longer resolves. The row
  /// is kept rather than deleted: a supply source may still point at it, and
  /// silently dropping it from the list would leave that source looking
  /// unconfigured instead of broken.
  isValid Boolean @default(true) @map("is_valid")

  /// Null for a value carried over from the free text field it replaced,
  /// which has never been checked against MetaKocka.
  validatedAt DateTime? @map("validated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, value])
  @@map("metakocka_profit_center")
}

/// Pricelists this company has, as far as we can see them.
///
/// docs/BUILD_SPEC.md §3: MetaKocka neither lists pricelists nor creates one, and the
/// rejection that names a pricelist's net-or-gross type only comes back from a
/// catalogue *write*. So this register is filled from the read-only side
/// (adapters/metakocka/pricelists.ts): every pricelist that has a price on a
/// product shows up there with its code, its title and its basis.
///
/// A row is a suggestion backed by evidence, not an authority. A pricelist with
/// no product priced on it is invisible to that read, so a merchant may
/// legitimately enter a code this table has never seen -- `observedAt` is null
/// for those, and the screen says the code could not be confirmed rather than
/// refusing it.
model MetakockaPricelist {
  id     String @id @default(cuid())
  shopId String @map("shop_id")

  /// The `count_code` a price is filed under.
  code  String
  /// MetaKocka's own name for it, when the read gave one.
  title String?

  /// True when prices on it include tax. Null when the read could not tell.
  ///
  /// A pricelist's type is fixed when it is created and unrelated to Shopify's
  /// tax setting. Sending the wrong basis is not a format error, it is a price
  /// wrong by the VAT rate that MetaKocka stores without complaint (3).
  includesTax Boolean? @map("includes_tax")

  /// When this code was last seen on a product. Null for a code the merchant
  /// entered that no priced product uses.
  observedAt DateTime? @map("observed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, code])
  @@map("metakocka_pricelist")
}

/// VAT rates seen on the company's own priced products.
///
/// Suggestions for the default VAT rate, never the source of truth: a rate a
/// merchant has not used yet is still a rate they may need. MetaKocka has no
/// endpoint that lists tax rates, so this is read from `tax_desc` on pricelist
/// entries alongside the pricelists themselves.
model MetakockaTaxRate {
  id     String @id @default(cuid())
  shopId String @map("shop_id")

  /// A percentage as a plain decimal string: "22", "9.5".
  percent String

  observedAt DateTime @default(now()) @map("observed_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, percent])
  @@map("metakocka_tax_rate")
}

enum SkuStatus {
  /// Present in Shopify, matched to a MetaKocka article by code.
  matched
  /// Present in Shopify, no MetaKocka article with that code.
  unmatched
  /// Deliberately excluded from sync by the merchant.
  ignored

  @@map("sku_status")
}

/// The SKU registry (docs/BUILD_SPEC.md §6): one row per Shopify variant, carrying the
/// identifiers both systems need. Matching is by code, Shopify `sku` against
/// MetaKocka `count_code`/`code`.
model Sku {
  id     String @id @default(cuid())
  shopId String @map("shop_id")

  sku                    String
  shopifyVariantId       String? @map("shopify_variant_id")
  shopifyInventoryItemId String? @map("shopify_inventory_item_id")
  shopifyProductId       String? @map("shopify_product_id")

  /// The product's own title, and the variant's option values, kept apart.
  ///
  /// Shopify's `displayName` glues them together with a hyphen, which is fine
  /// until a product title contains one. Keeping them separate is also what
  /// lets the order page show the product and its options as two lines, which
  /// is how a merchant reads a line: what it is, then which one.
  title        String?
  variantTitle String? @map("variant_title")

  /// What the merchant sees in Shopify, so the product list is scannable.
  ///
  /// A list of bare codes is not a product list — it is a database table with a
  /// heading. These come from the catalogue read, which already walks every
  /// variant, so showing them costs nothing at page load (docs/BUILD_SPEC.md §2.5).
  imageUrl    String? @map("image_url")
  priceMinor  Int?    @map("price_minor")
  currency    String?
  vendor      String?
  productType String? @map("product_type")

  metakockaCode String?   @map("metakocka_code")
  metakockaMkId String?   @map("metakocka_mk_id")
  /// The name MetaKocka currently holds, recorded when the catalogue is read.
  ///
  /// Stored so the settings screen can show what a name pattern would change
  /// without calling MetaKocka on a page load (docs/BUILD_SPEC.md §2.5). Null means the
  /// catalogue has not been read since this column existed, which the screen
  /// reports as unknown rather than as an empty name.
  metakockaName String?   @map("metakocka_name")
  status        SkuStatus @default(unmatched)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplyLevels SupplyLevel[]
  orderLines   OrderLine[]

  @@unique([shopId, sku])
  @@index([shopId, status])
  @@map("sku")
}

/// Stock for one SKU at one supply source (docs/BUILD_SPEC.md §6).
///
/// `quantity` is MetaKocka's `amount`, which §7 (verified) publishes as Shopify
/// on hand. `lastPushedQuantity` is what we last wrote to Shopify, so a no-op
/// write can be skipped. There is no inventory-level webhook subscription
/// today; the five-minute scheduled pass is the convergence mechanism.
model SupplyLevel {
  id             String @id @default(cuid())
  supplySourceId String @map("supply_source_id")
  skuId          String @map("sku_id")

  quantity Int
  reserved Int @default(0)

  observedAt DateTime @default(now()) @map("observed_at")

  lastPushedQuantity Int?      @map("last_pushed_quantity")
  lastPushedAt       DateTime? @map("last_pushed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  supplySource SupplySource @relation(fields: [supplySourceId], references: [id], onDelete: Cascade)
  sku          Sku          @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([supplySourceId, skuId])
  @@map("supply_level")
}

/// What the product sync is allowed to do to a name MetaKocka already holds.
enum ProductNamePolicy {
  /// Set the name from the template on every run.
  always
  /// Only fill in a name when MetaKocka has none.
  when_empty
  /// Never touch a name that already exists.
  never

  @@map("product_name_policy")
}

/// How Shopify products are pushed into MetaKocka (docs/BUILD_SPEC.md §8.9).
///
/// §8.9 gives Shopify the customer-facing title and MetaKocka everything else,
/// which is why every write here is off until the merchant turns it on, and why
/// creating an article with a price is a separate, deliberate switch: it is the
/// one place this app can put a price into the ERP, and the merchant has to ask
/// for it.
model ProductSyncSetting {
  id     String @id @default(cuid())
  shopId String @unique @map("shop_id")

  /// Master switch. Nothing is written to MetaKocka while this is false.
  enabled Boolean @default(false)

  /// Token template rendered by domain/products/template/.
  nameTemplate String            @default("{title}[ {options}]") @map("name_template")
  namePolicy   ProductNamePolicy @default(always) @map("name_policy")

  /// Create an article for a Shopify SKU MetaKocka does not have.
  createMissing Boolean @default(false) @map("create_missing")
  /// Send price and tax when creating one. Off means code and name only.
  sendPricing   Boolean @default(false) @map("send_pricing")
  /// Also write the price onto products MetaKocka already has. Deliberately a
  /// separate switch from sendPricing and off by default: §8.9 makes MetaKocka
  /// master for price, so overwriting one it already holds has to be a decision
  /// the merchant takes on purpose, not a side effect of enabling pricing.
  updatePricing Boolean @default(false) @map("update_pricing")

  /// Pricelist a price is written into. It must already exist in MetaKocka;
  /// the API cannot create one (§3).
  pricelistCode        String? @map("pricelist_code")
  /// Whether that pricelist holds gross prices.
  ///
  /// A MetaKocka pricelist has its own net-or-gross type, fixed when it was
  /// created and unrelated to Shopify's tax setting. Sending the wrong basis
  /// does not produce a format error, it produces a price wrong by the VAT
  /// rate. Corrected automatically when MetaKocka says otherwise, because it
  /// names the field it wants in the rejection.
  pricelistIncludesTax Boolean @default(true) @map("pricelist_includes_tax")
  /// Tax rate as a percentage, for example "22". Sent as `tax_factor`.
  taxPercent           String? @map("tax_percent")
  /// MetaKocka unit of measure for created articles.
  unit                 String  @default("kos")

  /// What kind of article MetaKocka holds: Prodajni, Nabavni, Storitev.
  ///
  /// `product_add` accepts these three flags and no others. The Delo and
  /// Osnovno sredstvo boxes in the MetaKocka UI have no API field at all, so
  /// they are not represented here. Left unset MetaKocka defaults every one of
  /// them to false, and an article that is not `sales` cannot go on a sales
  /// order, so the defaults below are what this app has always sent.
  productSales      Boolean @default(true) @map("product_sales")
  productPurchasing Boolean @default(false) @map("product_purchasing")
  productService    Boolean @default(false) @map("product_service")

  /// Also set those flags on articles MetaKocka already has.
  ///
  /// Separate and off by default for the reason `updatePricing` is: §8.9 makes
  /// MetaKocka master for what its own catalogue holds, so changing an article
  /// the ERP already owns is a decision the merchant takes deliberately.
  updateProductType Boolean @default(false) @map("update_product_type")

  /// Whether the catalogue is re-read and re-matched on a schedule.
  ///
  /// A manual sync is a promise the merchant has to remember to keep. Products
  /// change in Shopify and in MetaKocka every day, and a registry that is only
  /// as fresh as the last time somebody pressed a button is a registry that
  /// silently stops matching.
  scheduleEnabled         Boolean @default(false) @map("schedule_enabled")
  /// How often, in minutes. Labelled with its unit in the UI (docs/BUILD_SPEC.md §2.8).
  scheduleIntervalMinutes Int     @default(720) @map("schedule_interval_minutes")

  lastRunAt DateTime? @map("last_run_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("product_sync_setting")
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Orders (docs/BUILD_SPEC.md sections 6 and 8)
 */
/**
 * --------------------------------------------------------------------------
 */

enum OrderStatus {
  received
  allocated
  /// Every supply source has a MetaKocka document.
  written
  /// Something needs a human. There is an open Exception row alongside.
  needs_attention
  cancelled

  @@map("order_status")
}

/// Shopify's financial_status, narrowed to the values section 8.7 has a rule for.
enum OrderFinancialStatus {
  pending
  authorized
  paid
  partially_paid
  refunded
  partially_refunded
  voided
  unknown

  @@map("order_financial_status")
}

/// How close the connector believes MetaKocka is to Shopify for one order.
///
/// Distinct from `OrderStatus`, which describes how far the pipeline has got.
/// This describes whether the result is *correct*: an order can be `written`
/// and `inconsistent` at the same time, and before this existed there was no
/// way to say so.
enum OrderSyncState {
  /// Never reconciled, or reconciled before this column existed.
  pending
  /// Desired and actual agreed on the last pass, quantities and value checked.
  in_sync
  /// The quantity or value invariant is broken. **Never repaired by writing
  /// another document** — see domain/orders/invariants.
  inconsistent
  /// Convergence is waiting on a person: a locked document, an unmapped
  /// location, a gateway with no payment type.
  blocked

  @@map("order_sync_state")
}

/// The connector's own payment verdict, computed from individual transactions
/// rather than from Shopify's display status (domain/payments/transactions).
enum OrderPaymentState {
  unpaid
  authorized
  partially_paid
  paid
  overpaid
  partially_refunded
  refunded

  @@map("order_payment_state")
}

/// Who decided that a line comes from a particular supply source.
enum AllocationSource {
  /// This app's stock allocator (`domain/allocation`).
  rules
  /// Shopify's own fulfilment-order assignment, which is authoritative when
  /// it exists: a merchant moving a line between locations in the Shopify
  /// admin is stating where it ships from.
  shopify
  /// A person chose it on the order page.
  manual

  @@map("allocation_source")
}

/// Where the warehouse split of an order comes from.
enum AllocationMode {
  /// Follow Shopify's fulfilment orders, falling back to stock rules for the
  /// part of an order Shopify has not assigned to a location.
  shopify_locations
  /// Ignore Shopify's assignment and allocate purely from cached stock.
  stock_rules

  @@map("allocation_mode")
}

/// Who decides a sales order's number.
///
/// MetaKocka's `count_code` is what its screen labels *Sales ord. no.*, and it
/// is **not** unique on MetaKocka's side (docs/BUILD_SPEC.md §3) — so it is a
/// number, never an identity. This app's identity is `shopify_order_id` and the
/// `(shop_id, count_code)` claim on `metakocka_document`, which is internal and
/// is unaffected by either choice here.
enum SalesOrderNumbering {
  /// This app numbers the document, from `sales_order_number_template`.
  app
  /// No `count_code` is sent, so MetaKocka assigns its own — `1/2026` and on.
  /// Whatever it answers with is recorded, so the number is known from the
  /// first write onwards and is what every later update sends back.
  metakocka

  @@map("sales_order_numbering")
}

/// Whether one Shopify order becomes one MetaKocka sales order or several.
///
/// MetaKocka's `warehouse` is document-level, so an order fulfilled from two
/// warehouses can only be described as two documents. That is the default, and
/// it is the only shape that keeps ERP stock right.
///
/// `single` is the answer for a shop that does not want its ERP to hold the
/// split at all: one sales order carrying every line of the Shopify order, with
/// **no warehouse mark on it**, so MetaKocka files it against the company
/// default. It is a deliberate trade — the ERP no longer says which warehouse
/// the goods left from — and it is the merchant's to make.
enum SalesOrderSplit {
  /// One sales order per warehouse the order ships from.
  per_warehouse
  /// One sales order for the whole order, with no warehouse on it.
  single

  @@map("sales_order_split")
}

/// What to do with a MetaKocka document this order no longer takes anything
/// from (docs/BUILD_SPEC.md §8.8, `domain/orders/reconcile`).
enum ObsoleteDocumentPolicy {
  /// Leave it exactly as it is and raise an exception. The cautious original.
  report
  /// Rewrite it with no Shopify-linked lines so it stops carrying quantity,
  /// then raise the exception anyway. The default.
  empty
  /// Delete it, but only when no payment has been recorded against it.
  delete_unpaid

  @@map("obsolete_document_policy")
}

/// How one Shopify payment is spread over the several MetaKocka documents of
/// a split order (`domain/payments/allocation`).
enum PaymentAllocationStrategy {
  /// In proportion to what each document is worth. The default.
  proportional
  /// All of it on the one primary document.
  primary

  @@map("payment_allocation_strategy")
}

/// How the allocated payments are expressed in `mark_paid`.
enum PaymentEntryMode {
  /// One `mark_paid` entry per Shopify transaction, which is what the array
  /// shape exists for and what keeps two captures visible as two receipts.
  per_transaction
  /// One entry carrying the sum. The escape hatch, for a company whose
  /// MetaKocka configuration refuses a multi-entry array.
  aggregate

  @@map("payment_entry_mode")
}

/// Shopify's `OrderTransactionKind`, narrowed (`domain/payments/transactions`).
enum OrderPaymentKind {
  authorization
  capture
  sale
  void
  refund
  change
  other

  @@map("order_payment_kind")
}

/// Shopify's `OrderTransactionStatus`, narrowed. Only `success` is money.
enum OrderPaymentStatus {
  success
  pending
  failure
  error
  awaiting_response
  unknown

  @@map("order_payment_status")
}

model Order {
  id     String @id @default(cuid())
  shopId String @map("shop_id")

  shopifyOrderId     String @map("shopify_order_id")
  shopifyOrderNumber String @map("shopify_order_number")

  /// The MetaKocka partner this order belongs to, resolved once and reused.
  ///
  /// Resolved before any document is written, so the several jobs of a split
  /// order all reference the same partner instead of racing to create their
  /// own. Null until it has been looked up.
  metakockaPartnerMkId      String? @map("metakocka_partner_mk_id")
  metakockaPartnerAddressId String? @map("metakocka_partner_address_id")
  /// Claim making that lookup single-flight, in the mould of
  /// payment_claimed_at: taken before get_partner/add_partner, so two write
  /// jobs racing an unresolved order cannot both create the customer.
  metakockaPartnerClaimedAt DateTime? @map("metakocka_partner_claimed_at")

  /// Shared across every MetaKocka document from this order. Section 3: the
  /// field that actually links sibling documents is buyer_order.
  customerOrderRef String @map("customer_order_ref")

  status          OrderStatus          @default(received)
  financialStatus OrderFinancialStatus @default(unknown) @map("financial_status")

  /// Section 8.6: presentment currency and amount, never converted.
  presentmentCurrency String @map("presentment_currency")

  /// Order-level money in minor units (section 15). Shipping and discount go on
  /// the primary document only (section 8.6).
  totalMinor    Int @map("total_minor")
  shippingMinor Int @default(0) @map("shipping_minor")
  discountMinor Int @default(0) @map("discount_minor")

  /// The Shopify payload as received. PII is redacted in place after 90 days by
  /// the retention job (section 2.4); the decision trail outlives it.
  rawPayload Json?     @map("raw_payload")
  redactedAt DateTime? @map("redacted_at")

  receivedAt DateTime @default(now()) @map("received_at")

  /// Set when the order is deleted in Shopify.
  ///
  /// The row and its MetaKocka documents are kept. The ERP holds the real
  /// accounting record, which may already be invoiced, and deleting our side
  /// would destroy the trail that explains why it is there. The order is hidden
  /// from this app instead.
  shopifyDeletedAt DateTime? @map("shopify_deleted_at")

  /// Shopify's own `updated_at` for this order.
  ///
  /// The high-water mark that makes order updates safe. Shopify does not
  /// promise webhooks arrive in the order the changes happened, and the
  /// reconciler re-reads orders the webhooks already delivered, so an update
  /// carrying an older timestamp than the one already applied is discarded
  /// rather than allowed to undo a newer one.
  shopifyUpdatedAt DateTime? @map("shopify_updated_at")

  /// When this app last compared the order against Shopify, by webhook or by
  /// reconciliation. What the home page means by "orders are in step".
  lastSyncedAt DateTime? @map("last_synced_at")

  /// Shopify's fulfilment status, normalised (`FulfillmentState`). Read and
  /// shown, not acted on: tracking back to Shopify is M5.
  fulfillmentState String? @map("fulfillment_state")

  /// The gateway the order was paid on, kept out of the payload so a payment
  /// can still be described after the section 2.4 redaction has run.
  paymentGateway String? @map("payment_gateway")

  /// Set when Shopify cancels the order. The MetaKocka document stays where it
  /// is (section 8.8) and an exception asks a human to decide.
  cancelledAt DateTime? @map("cancelled_at")

  /// Set when Shopify's version of the order stopped matching what was written
  /// to MetaKocka: a line, a quantity, a price or a total changed after the
  /// document existed. Cleared when the exception is resolved.
  divergedAt DateTime? @map("diverged_at")

  /// A partner the merchant entered by hand, for an order Shopify has no
  /// address on.
  ///
  /// Point-of-sale orders, digital goods and some draft orders arrive with
  /// neither a billing nor a shipping address, and MetaKocka refuses a sales
  /// order without a partner. Before this the only advice the app could give
  /// was "add the address in Shopify and retry", which is not always possible
  /// and never quick. Shaped like `ParsedAddress`, and it wins over the payload
  /// when it is set.
  partnerOverride Json? @map("partner_override")

  /// Set when a person chose the supply sources themselves.
  ///
  /// Automatic allocation replaces the whole set every time it runs, so without
  /// this a hand-made decision would survive exactly until the next stock sync
  /// re-drove the order. Cleared by allocating again on purpose.
  allocationLockedAt DateTime? @map("allocation_locked_at")

  /// Single-flight guard around one order's reconciliation (§13 of the order
  /// reconciliation brief).
  ///
  /// Everything else in this app is guarded per *document* — the `count_code`
  /// claim — or per *payment*. That is enough to stop two writes of the same
  /// document and not enough to stop two reconciliations of the same order:
  /// two passes reading the same "no document yet" and then claiming two
  /// different `count_code`s for two different warehouses is a split that
  /// never happened. Taken as a conditional update with a lease, in the mould
  /// of `payment_claimed_at`, so the database settles the race rather than
  /// whichever job looked first.
  reconcileClaimedAt DateTime? @map("reconcile_claimed_at")
  /// When a reconciliation last completed, whatever verdict it reached.
  reconciledAt       DateTime? @map("reconciled_at")

  /// Whether MetaKocka currently agrees with Shopify, and why not.
  ///
  /// `syncDetail` holds the last verification result — per-SKU expected,
  /// actual and difference — because "this order is inconsistent" without the
  /// numbers is a banner nobody can act on.
  syncState  OrderSyncState @default(pending) @map("sync_state")
  syncDetail Json?          @map("sync_detail")

  /// The payment ledger, summarised (`domain/payments/transactions`).
  ///
  /// Materialised onto the order because every screen and every scheduled
  /// cross-check needs it and none of them may re-derive it from the
  /// transactions themselves — two derivations of the same money is how the
  /// dashboard and the order page come to disagree.
  paymentState       OrderPaymentState? @map("payment_state")
  grossReceivedMinor Int                @default(0) @map("gross_received_minor")
  refundedMinor      Int                @default(0) @map("refunded_minor")
  netPaidMinor       Int                @default(0) @map("net_paid_minor")
  outstandingMinor   Int                @default(0) @map("outstanding_minor")
  /// When the transaction ledger was last read from Shopify.
  paymentsReadAt     DateTime?          @map("payments_read_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop       Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  lines      OrderLine[]
  documents  MetakockaDocument[]
  exceptions Exception[]
  payments   OrderPayment[]

  @@unique([shopId, shopifyOrderId])
  @@index([shopId, syncState])
  @@index([shopId, status])
  @@index([shopId, receivedAt])
  @@index([shopId, financialStatus])
  @@map("order")
}

model OrderLine {
  id      String @id @default(cuid())
  orderId String @map("order_id")

  skuId String? @map("sku_id")
  /// Kept even when the SKU is unknown, so an unmatched line is still visible.
  sku   String

  title    String
  quantity Int

  /// Shopify presentment unit price in minor units. The document adapter sends
  /// it as `price` or `price_with_tax` according to the order's tax setting.
  /// The historical column name is retained to avoid a cosmetic migration.
  unitPriceWithTaxMinor Int     @map("unit_price_with_tax_minor")
  /// Section 8.6: derived from the Shopify tax lines, never a product default.
  taxFactor             String? @map("tax_factor")
  /// Line-level discounts stay with their line (section 8.6).
  discountMinor         Int     @default(0) @map("discount_minor")

  shopifyLineItemId String @map("shopify_line_item_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  skuRecord   Sku?         @relation(fields: [skuId], references: [id])
  allocations Allocation[]

  @@index([orderId])
  @@map("order_line")
}

enum AllocationStatus {
  planned
  written_to_shopify
  written_to_metakocka
  failed
  /// Nothing could satisfy it; a human decides (section 8.2).
  manual

  @@map("allocation_status")
}

model Allocation {
  id          String @id @default(cuid())
  orderLineId String @map("order_line_id")

  supplySourceId String?          @map("supply_source_id")
  quantity       Int
  status         AllocationStatus @default(planned)

  /// Which rule fired and why. The audit trail is a product feature.
  reason Json?

  /// Who decided this, and which Shopify location it came from.
  ///
  /// `shopify` means the merchant said so by assigning a fulfilment order, and
  /// that outranks anything this app's stock rules would have chosen. Keeping
  /// the location id alongside the supply source matters for the case the
  /// mapping cannot answer: a location with no supply source has an allocation
  /// row naming it, so the exception can say *which* location is unmapped
  /// instead of "part of this order could not be allocated".
  source            AllocationSource @default(rules)
  shopifyLocationId String?          @map("shopify_location_id")

  /// Set once the fulfilment order has been moved or split (section 8.3).
  shopifyFulfillmentOrderId String? @map("shopify_fulfillment_order_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orderLine    OrderLine     @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  supplySource SupplySource? @relation(fields: [supplySourceId], references: [id])

  @@index([orderLineId])
  @@index([supplySourceId])
  @@map("allocation")
}

enum DocumentStatus {
  pending
  written
  failed

  @@map("document_status")
}

model MetakockaDocument {
  id     String @id @default(cuid())
  shopId String @map("shop_id")

  orderId        String  @map("order_id")
  supplySourceId String? @map("supply_source_id")

  /// Exactly one document per order is the primary money share. Shipping and
  /// order-level discounts are assigned to that share, although their
  /// MetaKocka request representation remains an open verified-API gap.
  isPrimary Boolean @default(false) @map("is_primary")

  docType String @default("sales_order") @map("doc_type")

  /// The app's internal claim key, `SH-{orderNumber}-{sourceCode}`.
  ///
  /// **Not necessarily what MetaKocka was told.** Section 3 verified MetaKocka
  /// does not treat `count_code` as unique, so the uniqueness below is the only
  /// duplicate guard there is — which means this column has to stay stable and
  /// collision-free whatever the merchant does to their numbering settings. It
  /// is derived from `order.customer_order_ref`, which is itself frozen at
  /// intake, so it never moves.
  countCode String  @map("count_code")

  /// The number MetaKocka actually holds, and what its screen shows as
  /// *Sales ord. no.*
  ///
  /// Under `app` numbering this is the rendered
  /// `sales_order_number_template` — usually the same string as `count_code`,
  /// which is why existing rows were backfilled from it. Under `metakocka`
  /// numbering nothing is sent and this is filled in from the response, so the
  /// number is known from the first write onwards and every later update sends
  /// the same one back rather than risking a renumber.
  ///
  /// Null only while a claimed document has not been written yet, or when a
  /// write landed and MetaKocka's answer did not name a number.
  sentCountCode String? @map("sent_count_code")

  mkId      String? @map("mk_id")

  status DocumentStatus @default(pending)

  /// Section 8.7: mark_paid replaces the previous payment, so it is sent once
  /// and this records that it happened.
  paymentMarkedAt DateTime? @map("payment_marked_at")

  /// Which MetaKocka payment type was used and for how much, in minor units.
  ///
  /// Recorded because "this document was marked paid" is not enough to
  /// reconcile against: a split order pays each document its own share
  /// (section 8.6), and the shares have to be shown to add up.
  paymentType        String? @map("payment_type")
  paymentAmountMinor Int?    @map("payment_amount_minor")

  /// The app's latest read-back verdict and when MetaKocka was asked. Verified
  /// sales-order responses expose neither workflow status nor tracking, so the
  /// poller records `in step`, `edited in MetaKocka`, or `missing` here.
  mkStatus        String?   @map("mk_status")
  mkDocNumber     String?   @map("mk_doc_number")
  mkCheckedAt     DateTime? @map("mk_checked_at")
  /// Reserved for a future verified tracking source; sales-order read-back does
  /// not currently populate it.
  trackingNumbers Json?     @map("tracking_numbers")

  /// Taken before the payment call goes out, released by paymentMarkedAt.
  ///
  /// The same shape of guard as the count_code claim, and for the same reason:
  /// mark_paid on an update deletes the previous payment and replaces it, so
  /// two jobs arriving together must not both send one.
  paymentClaimedAt DateTime? @map("payment_claimed_at")

  /// Redacted with the order after 90 days. Recorded whatever the outcome,
  /// because section 8.4 requires the request and response either way.
  requestBody  Json? @map("request_body")
  responseBody Json? @map("response_body")

  /// Set when this order stopped taking anything from the document's warehouse.
  ///
  /// A retired document is **excluded from payment allocation** and from the
  /// order's desired state, and included in the *actual* quantity total —
  /// which is the whole point: whatever MetaKocka still holds on it is exactly
  /// what the quantity invariant has to report. It is never deleted merely for
  /// being retired (§8.8: it may already be invoiced); the merchant's obsolete
  /// document policy decides whether it is emptied first.
  retiredAt     DateTime? @map("retired_at")
  retiredReason String?   @map("retired_reason")

  /// When a reconciliation last brought this document in line, or confirmed it
  /// already was. Distinct from `mkCheckedAt`, which is the read-back poll.
  lastReconciledAt DateTime? @map("last_reconciled_at")

  /// When the `count_code` claim on this row was taken.
  ///
  /// The lease that lets a document abandoned by a crashed worker be retried
  /// has to be measured from something only claiming moves. It used to be
  /// measured from `updated_at`, which Prisma refreshes on *any* write — and
  /// the reconciler writes `is_primary` to every document of an order before
  /// the write loop runs. That renewed the lease a moment before it was
  /// tested, so a row left `pending` by a crash could never be reclaimed: it
  /// stayed pending for ever, nothing retried it, and the order stayed
  /// inconsistent with no way back. Found by killing a write mid-flight
  /// against the real ERP.
  claimedAt DateTime? @map("claimed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop                Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order               Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplySource        SupplySource?             @relation(fields: [supplySourceId], references: [id])
  paymentApplications OrderPaymentApplication[]

  @@unique([shopId, countCode])
  @@index([orderId])
  @@map("metakocka_document")
}

/// One Shopify payment movement, as a durable ledger entry (§8.7).
///
/// The identity that makes payment synchronisation idempotent. Shopify
/// redelivers `orders/paid`, the reconciler re-reads paid orders every quarter
/// of an hour, and a retried job re-reads them again — and none of it can
/// record the same money twice, because a transaction is a row with a unique
/// Shopify id rather than an event that happened to arrive.
///
/// Every transaction is stored, not only the settled ones. An authorization
/// that was never captured is the explanation for an order that Shopify calls
/// authorized and the ERP calls unpaid, and a failed transaction is the
/// explanation for an order that looks like it should have been paid and was
/// not. Which of them count as money is `domain/payments/transactions`, and
/// nothing here decides it.
model OrderPayment {
  id      String @id @default(cuid())
  shopId  String @map("shop_id")
  orderId String @map("order_id")

  shopifyTransactionId String             @map("shopify_transaction_id")
  kind                 OrderPaymentKind
  status               OrderPaymentStatus

  /// Always the magnitude, never signed: direction is `kind`'s job. Minor
  /// units, presentment currency, like everything else on the order (§8.6).
  amountMinor Int    @map("amount_minor")
  currency    String

  gateway     String?
  processedAt DateTime? @map("processed_at")
  /// The authorization a capture belongs to, or the sale a refund reverses.
  parentTransactionId String? @map("parent_transaction_id")

  /// The MetaKocka payment type this receipt resolved to, from the gateway
  /// mapping. Recorded per transaction because a single order can be paid
  /// partly by card and partly by transfer, and the two are different types.
  metakockaPaymentType String? @map("metakocka_payment_type")

  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  shop         Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order        Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  applications OrderPaymentApplication[]

  /// The whole point. A retry cannot create a second row for one transaction.
  @@unique([shopId, shopifyTransactionId])
  @@index([orderId])
  @@map("order_payment")
}

/// A ledger entry's share of one MetaKocka document.
///
/// The join that keeps the multi-document payment rule honest: a Shopify
/// payment belongs to the *order*, and this records how much of it each
/// document was told about. The sum of one transaction's applications is that
/// transaction's amount — never the whole payment on every document, which for
/// a 300 order split 100/200 would put 600 in the merchant's books.
model OrderPaymentApplication {
  id             String @id @default(cuid())
  orderPaymentId String @map("order_payment_id")
  documentId     String @map("document_id")

  amountMinor Int    @map("amount_minor")
  paymentType String @map("payment_type")

  /// When MetaKocka confirmed the document carrying this share. Null while the
  /// share is planned but not yet written.
  appliedAt DateTime? @map("applied_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orderPayment OrderPayment      @relation(fields: [orderPaymentId], references: [id], onDelete: Cascade)
  document     MetakockaDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([orderPaymentId, documentId])
  @@index([documentId])
  @@map("order_payment_application")
}

/// A business condition needing a human (section 11). Not a retryable failure,
/// and not a form validation error.
enum ExceptionKind {
  sku_not_in_metakocka
  insufficient_stock
  profit_center_rejected
  warehouse_invalid
  unmapped_payment_gateway
  partially_paid
  voided_payment
  refund_received
  order_cancelled
  order_edited
  metakocka_write_failed
  fulfillment_split_failed
  tax_undeterminable
  /// Shopify's order no longer matches the document MetaKocka holds.
  order_diverged
  /// Stock could not be synced for a location, and kept not working.
  stock_sync_failed
  /// The document was deleted in MetaKocka. Verified as a thing that happens.
  metakocka_document_missing
  /// The document is still there but no longer says what this app sent.
  metakocka_document_changed
  /// The payment could not be recorded against the MetaKocka document.
  payment_write_failed
  /// A background job ran out of retries. Raised from the dead-letter queue so
  /// work stopping is something a merchant can see, not a log line.
  job_failed
  /// The order carries money - shipping, a discount - that has no configured
  /// MetaKocka representation, so the sales order cannot account for the whole
  /// commercial total. A settings decision, not a failure.
  commercial_representation_missing
  /// The quantity or value invariant is broken: what MetaKocka holds for this
  /// order is not what Shopify says it should. Deliberately its own kind
  /// rather than an `order_diverged`, because the response is different —
  /// divergence means "Shopify moved", this means "the two do not add up".
  sync_inconsistent
  /// Money arrived that could not be placed on any MetaKocka document.
  payment_unallocated
  /// Shopify assigned part of an order to a location with no supply source.
  unmapped_location

  @@map("exception_kind")
}

enum ExceptionStatus {
  open
  resolved
  ignored

  @@map("exception_status")
}

model Exception {
  id     String @id @default(cuid())
  shopId String @map("shop_id")

  orderId String? @map("order_id")

  kind    ExceptionKind
  /// Says what is wrong and what to do about it (section 2.8).
  message String
  detail  Json?

  /// Identity of the condition this row is about, e.g. "order:<id>" or
  /// "source:<id>". Lets an orderless condition (a location's stock sync)
  /// dedupe the same way an order-scoped one always has, instead of piling up
  /// one row per failed attempt. Null for older rows and anything that has no
  /// natural identity beyond (shop, kind). A partial unique index below
  /// enforces one open row per (shop, kind, dedupe_key).
  dedupeKey String? @map("dedupe_key")

  status     ExceptionStatus @default(open)
  resolvedBy String?         @map("resolved_by")
  resolvedAt DateTime?       @map("resolved_at")

  /// How many times the work behind this has been re-driven, and when last.
  ///
  /// An exception whose retry keeps failing looks identical to one nobody has
  /// touched, which is how "Retry does nothing" happens: it did something, it
  /// failed the same way, and the screen had no way to say so.
  attempts      Int       @default(0)
  lastAttemptAt DateTime? @map("last_attempt_at")

  /// When the background re-check last looked at this.
  ///
  /// Exceptions are conditions, not events: "not enough stock" stops being true
  /// the moment stock arrives, and nothing in Shopify or MetaKocka will announce
  /// that. So a scheduled job re-evaluates every open exception and closes the
  /// ones that have fixed themselves (`recheck-exceptions`).
  lastCheckedAt DateTime? @map("last_checked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop  Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([shopId, status])
  @@index([orderId])
  // One open row per (shop, kind, dedupe_key) is enforced by a partial unique
  // index (WHERE status = 'open' AND dedupe_key IS NOT NULL) that Prisma's
  // schema language cannot express; it is created by hand in
  // 20260826030000_exception_dedupe/migration.sql and doubles as the lookup
  // index for the case that matters (an open row by its dedupe key).
  @@map("exception")
}

/// How this app treats a sales order MetaKocka has already accepted.
///
/// §8.8 originally said an order that changes after it has been written is a
/// human's problem, and automatic re-allocation was a phase 2 decision. In
/// practice that left the ERP holding quantities nobody had agreed to, with an
/// exception the merchant could read but not act on — so the behaviour is a
/// choice they make rather than one the app makes for them.
model SalesOrderSetting {
  id     String @id @default(cuid())
  shopId String @unique @map("shop_id")

  /// Whether orders are transferred to MetaKocka at all.
  ///
  /// On by default. Off is a hard stop: nothing about any order — not a
  /// document, not a payment — is written to the ERP while it is off, including
  /// for orders MetaKocka already holds. Orders are still received and shown,
  /// so nothing is lost. See `domain/orders/transfer`.
  transferOrders Boolean @default(true) @map("transfer_orders")

  /// Orders received before this moment with no document yet are left alone.
  ///
  /// Set when transfer is turned back on without its backlog: an order
  /// received while it was off was handled some other way, and transferring
  /// it later would duplicate it. An order MetaKocka already holds is never
  /// held back by this. Null means there is no cut-off.
  transferOrdersSince DateTime? @map("transfer_orders_since")

  /// Rewrite the MetaKocka document when the Shopify order changes.
  ///
  /// On by default, because the alternative is an ERP that is quietly wrong.
  /// MetaKocka treats an update as a replacement (§3), so the document is
  /// rebuilt whole and read back afterwards; it is never patched.
  updateOnChange Boolean @default(true) @map("update_on_change")

  /// Keep updating even after a payment has been recorded against it.
  ///
  /// Off by default, and this is the safety rail. A paid document is the one
  /// most likely to have been invoiced in MetaKocka, and replacing an invoiced
  /// document changes an accounting record. With this off, a change to a paid
  /// order raises an exception instead — the same behaviour as turning updates
  /// off entirely, applied only where the stakes are highest.
  updateAfterPaid Boolean @default(false) @map("update_after_paid")

  /// What MetaKocka shows as *Customer's order*, as a template.
  ///
  /// Rendered once at intake into `order.customer_order_ref` and never
  /// recomputed: that string is also the `buyer_order` every sibling document
  /// carries and the only reference an ambiguous write can be recovered by
  /// (§3), so re-rendering it after a template change would orphan documents
  /// MetaKocka already holds. Null means the default, `SH-{{order.number}}`.
  /// See `domain/orders/reference` for the placeholders.
  customerOrderTemplate String? @map("customer_order_template")

  /// Where the warehouse split comes from.
  ///
  /// `shopify_locations` by default: a merchant moving a line to another
  /// location in the Shopify admin is stating where it ships from, and the ERP
  /// should follow. Stock rules still fill in whatever Shopify has not
  /// assigned — a digital line, a third-party fulfilment this app cannot read.
  allocationMode AllocationMode @default(shopify_locations) @map("allocation_mode")

  /// Whether one Shopify order becomes one MetaKocka sales order or several.
  ///
  /// `per_warehouse` by default, because MetaKocka's `warehouse` is
  /// document-level and splitting is the only way an ERP can hold where goods
  /// actually left from. `single` writes one document for the whole order with
  /// no warehouse mark, for shops that keep their stock somewhere else and want
  /// the sales order to mirror the Shopify order one for one. Under `single`
  /// nothing is allocated to a warehouse at all, so `allocationMode` above has
  /// no effect.
  salesOrderSplit SalesOrderSplit @default(per_warehouse) @map("sales_order_split")

  /// Who decides the number MetaKocka shows as *Sales ord. no.*
  ///
  /// `app` by default, which is what this connector has always done. `metakocka`
  /// sends no `count_code` at all and lets the ERP's own sequence answer, for a
  /// merchant whose accountant expects MetaKocka's numbering on its documents.
  salesOrderNumbering SalesOrderNumbering @default(app) @map("sales_order_numbering")

  /// The pattern the document number is rendered from, under `app` numbering.
  ///
  /// Null means *the same as the customer's order reference*, which is what
  /// every document written before this setting existed carries — so the
  /// default is not a string that could drift away from
  /// `customer_order_template`, it is that template's own result. A split
  /// order suffixes the supply source's code, because sibling documents cannot
  /// share a number.
  ///
  /// Rendered once and frozen in `metakocka_document.sent_count_code`, for the
  /// same reason `customer_order_ref` is frozen at intake: re-rendering it
  /// after a template change would renumber documents MetaKocka already holds,
  /// and a document's number is an accounting record.
  salesOrderNumberTemplate String? @map("sales_order_number_template")

  /// What happens to a document this order stops taking anything from.
  obsoleteDocumentPolicy ObsoleteDocumentPolicy @default(empty) @map("obsolete_document_policy")

  /// Whether the connector records payments in MetaKocka at all.
  ///
  /// On by default. Off is for a merchant who settles in the ERP by hand and
  /// wants the connector to describe the order and nothing else; the ledger is
  /// still read and shown either way, because "what has this customer paid" is
  /// worth answering whoever writes it down.
  syncPayments Boolean @default(true) @map("sync_payments")

  paymentAllocation PaymentAllocationStrategy @default(proportional) @map("payment_allocation")
  paymentEntryMode  PaymentEntryMode          @default(per_transaction) @map("payment_entry_mode")

  /// The MetaKocka product code a shipping charge is written against.
  ///
  /// Merchant-supplied, never derived: it is an article in their own catalogue
  /// and only they know which one their accountant expects postage on. Null
  /// means shipping has no representation, and an order that carries shipping
  /// is then reported rather than quietly sent short.
  shippingProductCode String? @map("shipping_product_code")

  /// How a discount is written. See `DiscountRepresentation`.
  discountRepresentation DiscountRepresentation @default(none) @map("discount_representation")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("sales_order_setting")
}

/// How Shopify's non-product money reaches a MetaKocka sales order.
///
/// Verified live on 2026-08-26 (docs/metakocka-verification.md): an extra
/// positive line adds to `sum_all` exactly, so shipping is a line; the
/// document-level `discount_value` is an **absolute amount**, which is exactly
/// what Shopify supplies, while the per-line `discount` is a **percentage** and
/// would need a conversion this app has no authority to invent.
enum DiscountRepresentation {
  /// Not configured. An order carrying a discount is reported rather than
  /// silently sent without one.
  none
  /// The document's `discount_value`, as an absolute amount.
  document_discount_value

  @@map("discount_representation")
}

/// Shop-level payment settings (docs/BUILD_SPEC.md section 8.7).
///
/// Separate from `payment_type_map`, which is one row per gateway: this is the
/// single answer for gateways that have no row at all. Section 8.7 says never to
/// guess a payment type, and this does not — it is a value the merchant chose
/// and the settings screen refuses to save without.
model PaymentSetting {
  id     String @id @default(cuid())
  shopId String @unique @map("shop_id")

  /// Used when an order arrives on a gateway with no mapping of its own.
  fallbackPaymentType String? @map("fallback_payment_type")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("payment_setting")
}

/// Shop-level stock and profit centre defaults (docs/BUILD_SPEC.md §7).
///
/// Most merchants answer "where is stock counted" once for the whole store,
/// and the warehouse screen used to ask it again for every warehouse. These
/// are the answers a supply source inherits unless it says otherwise; which
/// sources inherit is recorded on the source itself, so the sync engine keeps
/// reading one materialised column and never resolves a default at read time.
model SupplySetting {
  id     String @id @default(cuid())
  shopId String @unique @map("shop_id")

  /// Where stock is counted, for every location that has not overridden it.
  defaultStockDirection StockDirection @default(mk_to_shopify) @map("default_stock_direction")

  /// The profit centre orders carry, for every location that has not
  /// overridden it. Null means none is sent and MetaKocka applies the company
  /// setting, which is what it did before this app existed.
  defaultProfitCenter String? @map("default_profit_center")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("supply_setting")
}
